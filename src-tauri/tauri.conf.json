{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Tracker",
  "version": "0.1.0",
  "identifier": "app.usage-tracker.desktop",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:3142",
    "beforeDevCommand": "node server.js --port 3142"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../server.js",
      "../lib",
      "../public",
      "../package.json",
      "../node_modules"
    ],
    "category": "Utility",
    "shortDescription": "Local Claude, Codex, and Grok usage meters",
    "longDescription": "A lightweight local tray app that shows Claude, ChatGPT/Codex, and Grok subscription usage from your existing CLI logins.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
